# GEMINI_API_KEY: Production Google AI Studio API Key (server-side only).
# Recommended: Restrict this key in Google AI Studio / Google Cloud Console
# to your app domains (HTTP Referrers) and the Generative Language API.
# AI Studio automatically injects GEMINI_API_KEY at runtime from Settings > Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Canonical URL where this applet is deployed/hosted.
# Used by server-side Gemini proxy routes as the Referer header so
# domain-restricted production Google AI Studio keys authenticate cleanly upon deployment.
APP_URL="MY_APP_URL"

# Optional secondary stronger/ultra-fast AI failover providers (server-side only):
# Set any of these in Settings > Secrets to automatically failover if Gemini is unavailable.
# OPENROUTER_API_KEY=""
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# GROQ_API_KEY=""
# DEEPSEEK_API_KEY=""
